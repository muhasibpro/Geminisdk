# Gemini Veo Image-to-Video. Create your own .env file and paste the real key there.
GEMINI_API_KEY=
AI_VIDEO_PROVIDER=gemini
AI_VIDEO_GEMINI_MODEL=veo-3.1-generate-preview
AI_VIDEO_GEMINI_RESOLUTION=720p

# OpenAI Voice + browser chat. The API key is separate from a ChatGPT subscription.
OPENAI_API_KEY=
# Model behind the "ChatGPT Sol" option in the chat model picker.
OPENAI_CHAT_MODEL=gpt-5.6-sol
# Tool-call rounds allowed per message before the agent stops.
OPENAI_CHAT_MAX_STEPS=24
# Low-latency interruption-capable browser voice mode (optional overrides).
# Valid voices ONLY: marin, cedar, coral, sage, verse, ash, ballad, alloy, echo,
# shimmer, nova, fable, onyx. ChatGPT Desktop product names (sol, breeze, cove,
# ember, vale, ...) are NOT API voice ids — they are aliased to the nearest real one.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Text-to-speech for the "Ovozda tinglash" button.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Speech-to-text inside live voice mode.
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe

# Optional Fal fallback.
FAL_KEY=
AI_VIDEO_FAL_MODEL=fal-ai/kling-video/v3/pro/image-to-video

# Optional Replicate fallback. Set these only when using AI_VIDEO_PROVIDER=replicate.
REPLICATE_API_TOKEN=
AI_VIDEO_REPLICATE_MODEL=
AI_VIDEO_REPLICATE_IMAGE_FIELD=input_image
AI_VIDEO_REPLICATE_PROMPT_FIELD=prompt
AI_VIDEO_REPLICATE_DURATION_FIELD=
